<div class="events">
  {% if site.projects != blank %}
    {% assign events_size = site.projects | size %}

    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and events_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign events = site.projects | reverse %}

        {% if include.limit and page.announcements.limit %}
          {% assign events_limit = page.announcements.limit %}
        {% else %}
          {% assign events_limit = events_size %}
        {% endif %}

        {% for item in events limit: events_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {{ item.date | date: '%b %Y' }}

              {% if item.end_date %}
                – {{ item.end_date | date: '%b %Y' }}
              {% endif %}
            </th>

            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="event-title" href="{{ item.url | relative_url }}">
                  {{ item.title }}
                </a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No events so far...</p>
  {% endif %}
</div>